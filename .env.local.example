# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git – never commit real keys, passwords or URLs.

# Admin dashboard password
ADMIN_PASSWORD=change_me_to_a_strong_password

# Supabase – Project Settings → API (server-side only, never NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional – Google Apps Script web app URL (see google-apps-script.js)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
